---
import type { FaqItem } from '../site';
interface Props {
  items: FaqItem[];
  title?: string;
}
const { items, title = 'Questions fréquentes' } = Astro.props;
---
<section class="faq section" aria-labelledby="faq-title">
  <h2 id="faq-title">{title}</h2>
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <div set:html={i.a} />
    </details>
  ))}
</section>

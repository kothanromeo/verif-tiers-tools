---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { breadcrumbSchema, href } from '../../site';

const posts = (await getCollection('guides')).sort((a, b) => +b.data.published - +a.data.published);
const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Guides', path: '/guides/' },
];
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  keywords={["vérifier siren", "numéro tva intracommunautaire", "clé tva", "vérifier iban", "clé rib", "siret luhn", "fichier clients siren", "guide siren tva iban"]}
  title="Guides : SIREN, TVA intracommunautaire et IBAN"
  description="Mettre à jour son fichier clients, calculer une clé de TVA, comprendre SIREN, SIRET et clé de Luhn, vérifier un IBAN et une clé RIB : des guides concrets, formules à l’appui."
  schema={[breadcrumbSchema(Astro.site!, crumbs)]}
>
  <Crumbs items={crumbs} />
  <section class="hero wrap narrow">
    <h1>Guides SIREN, TVA et IBAN</h1>
    <p class="lead">
      Des explications concrètes sur le format et sur la réforme, écrites par un développeur qui a passé du temps dans les spécifications
      pour que vous n’ayez pas à le faire.
    </p>
  </section>
  <div class="wrap narrow">
    <ul class="post-list">
      {posts.map((p) => (
        <li class="card">
          <a href={href(`/guides/${p.id}/`)}>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <time datetime={p.data.published.toISOString()}>{fmt(p.data.published)}</time>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
